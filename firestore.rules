rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Cache collection rules
    // Used for caching GitHub API responses (public data only)
    match /cache/{document=**} {
      // Allow read access to everyone (cache is public)
      allow read: if true;

      // Allow write access to everyone (cache data is non-sensitive)
      allow write: if true;

      // Auto-delete expired cache entries (optional, but recommended)
      // Note: This requires Firebase Extensions or manual cleanup
    }

    // Deny all other collections by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
